# --- Stream jeux vidéo (/stream) ---
# Optionnel : application Twitch (dev.twitch.tv/console, 2FA requise) pour l'API IGDB,
# qui ajoute aux résultats Steam les jeux absents de Steam (résumés en anglais)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Salon "seances-jeu-vidéo" où les annonces sont postées
STREAM_CHANNEL_ID=1571557934188470413
# Rôle "Jeuxvideos" mentionné sur les annonces et le rappel
STREAM_ROLE_ID=1571558610880823397
# Alerte « en live » (nécessite TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET) :
# chaînes surveillées, logins séparés par des virgules (défaut : funny_games_discord)
TWITCH_LIVE_LOGINS=funny_games_discord
# Salon et rôle de l'alerte ; vides = STREAM_CHANNEL_ID / STREAM_ROLE_ID
TWITCH_LIVE_CHANNEL_ID=
TWITCH_LIVE_ROLE_ID=

# --- Letterboxd (/scan-letterbox, /list-letterbox) ---
# Salon de partage des réseaux sociaux des membres
SOCIAL_NETWORKS_CHANNEL_ID=1571172240517632020
