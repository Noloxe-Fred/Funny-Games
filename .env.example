# Rôle mentionné au lancement de chaque nouvelle manche (palier 1 uniquement)
QUIZ_ROLE_JOUONS_A_UN_JEU_ID=1571535730038280365

# --- Ciné-Club ---
TMDB_API_KEY=                 # clé API v3 TMDB (themoviedb.org)

CINE_CLUB_CHANNEL_ID=1459244323441868870    
CINE_CLUB_STREAMER_ROLE_ID=   # rôle streamer (/cine, /stream, suppressions) ; vide = admins uniquement
